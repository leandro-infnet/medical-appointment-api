# Copiar para .env; preencher apenas localmente com dados fictícios.
JWT_SECRET=<chave gerada>
MFA_SIMULATED_CODE=<seis dígitos fictícios escolhidos por você>
JWT_ISSUER=medical-appointment-api
JWT_AUDIENCE=clinic-human-clients
ACCESS_TOKEN_MINUTES=15
USERS_FILE=.local/usuarios.json
# Manter true com HTTPS; false somente em desenvolvimento HTTP local.
AGENDA_COOKIE_SECURE=true

# Laboratório fica desativado sem hash. Gerar com python -m app.auth.provision_m2m.
M2M_CLIENT_ID=laboratorio_parceiro
M2M_CLIENT_SECRET_HASH=
M2M_TOKEN_MINUTES=5
